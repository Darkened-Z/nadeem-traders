# =============================================
# Nadeem Traders — Environment Variables Template
# =============================================
# Copy this file to .env and fill in your actual values.
# For production (Vercel), set these in the Vercel project dashboard under
# Settings → Environment Variables.

# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://..."

# --- Resend (Email Service) ---
RESEND_API_KEY="re_..."
# Production needs a verified domain (onboarding@resend.dev only delivers to the Resend account owner)
MAIL_FROM="Nadeem Traders <onboarding@resend.dev>"

# --- Google OAuth 2.0 (Server-side) ---
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# --- Google OAuth 2.0 (Frontend/Browser — MUST be VITE_ prefixed) ---
VITE_GOOGLE_CLIENT_ID="....apps.googleusercontent.com"

# --- Admin Notification Email ---
ADMIN_EMAIL="your-admin@example.com"

# --- App URL (used for OAuth redirects) ---
# Local: http://localhost:5173
# Vercel: https://your-app.vercel.app
APP_URL="http://localhost:5173"

# --- Admin portal (/admin) ---
# Password for the admin login, and a random 64+ char secret used to sign the admin session cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- PostHog (funnels & session recordings). Public project key, starts with phc_ ---
VITE_POSTHOG_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com, matching your PostHog region
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Server-side keys for admin "Visitors & Funnel" (/admin/visitors) HogQL queries
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# --- Google Search Console (admin "Google Search" page). Full service-account JSON key, on one line ---
GSC_SERVICE_ACCOUNT=
# Optional; defaults to the domain property
GSC_SITE_URL=sc-domain:nadeemtraders.com

# --- Google Analytics 4 (storefront tracking + admin "Google Analytics" page) ---
# Browser tracking tag (optional if loaded via GTM). Starts with G-
VITE_GA_MEASUREMENT_ID=
# Numeric GA4 Property ID from Google Analytics -> Admin -> Property Settings (e.g. 123456789)
GA4_PROPERTY_ID=
# Optional separate service-account JSON key; if blank, falls back to GSC_SERVICE_ACCOUNT
GA4_SERVICE_ACCOUNT=
# Google Cloud API key restricted to "PageSpeed Insights API" (admin site speed card)
PAGESPEED_API_KEY=
